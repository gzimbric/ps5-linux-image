[Unit]
Description=Capture a bounded PS5 boot report
After=local-fs.target NetworkManager.service sshd.service ps5fan.service ps5-amdgpu-reprobe.service ps5-iw620-firmware.service ps5-performance.service ps5-session-switch-listener.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ps5-boot-report
TimeoutStartSec=25
TimeoutStopSec=5
Nice=10
IOSchedulingClass=idle
