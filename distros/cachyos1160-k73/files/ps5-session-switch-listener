#!/usr/bin/python3
"""Bridge Steam's DisplayManager desktop request to the PS5 tty launcher."""

import os
import queue
import re
import subprocess
import sys
import threading
import time


DBUS_MONITOR = "/usr/bin/dbus-monitor"
LOGINCTL = "/usr/bin/loginctl"
SESSION_SELECT = "/usr/bin/steamos-session-select"

DESTINATION = "org.freedesktop.DisplayManager"
OBJECT_PATH = "/org/freedesktop/DisplayManager/Seat0"
INTERFACE = "org.freedesktop.DisplayManager.Seat"
MEMBER = "SwitchToUser"
ALLOWED_DESKTOPS = frozenset(("desktop", "plasma", "plasma-wayland"))

MATCH_RULE = (
    "type='method_call',"
    "destination='org.freedesktop.DisplayManager',"
    "path='/org/freedesktop/DisplayManager/Seat0',"
    "interface='org.freedesktop.DisplayManager.Seat',"
    "member='SwitchToUser'"
)
MESSAGE_PREFIXES = ("method call ", "method return ", "signal ", "error ")
EVENT_SETTLE_SECONDS = 0.20
DEBOUNCE_SECONDS = 2.0


def log(message):
    print("ps5-session-switch-listener: " + message, flush=True)


def header_field(header, name):
    matches = re.findall(r"(?:^|[ ;])" + re.escape(name) + r"=([^ ;]+)", header)
    if len(matches) != 1:
        return None
    return matches[0]


def parse_request(header, body):
    """Return the requested desktop name only for the exact expected call."""
    if not header.startswith("method call "):
        return None

    expected_fields = {
        "destination": DESTINATION,
        "path": OBJECT_PATH,
        "interface": INTERFACE,
        "member": MEMBER,
    }
    for name, expected in expected_fields.items():
        if header_field(header, name) != expected:
            return None

    # The real method has exactly two plain string arguments. Deliberately do
    # not accept variants, arrays, escaped values, or additional arguments.
    if len(body) != 2:
        return None
    values = []
    for line in body:
        match = re.fullmatch(r'\s*string "([^"\\]*)"\s*', line)
        if match is None:
            return None
        values.append(match.group(1))

    if values[0] != "doorstop" or values[1] not in ALLOWED_DESKTOPS:
        return None
    return values[1]


def text_events(lines):
    """Split textual dbus-monitor output into header/body events."""
    header = None
    body = []
    for raw_line in lines:
        line = raw_line.rstrip("\r\n")
        if line.startswith(MESSAGE_PREFIXES):
            if header is not None:
                yield header, body
            header = line
            body = []
        elif header is not None and not line.strip():
            yield header, body
            header = None
            body = []
        elif header is not None:
            body.append(line)
    if header is not None:
        yield header, body


def _read_monitor_lines(stream, output_queue):
    try:
        for line in stream:
            output_queue.put(line)
    finally:
        output_queue.put(None)


def live_events(process):
    """Yield complete events, using a short quiet period as a message boundary."""
    output_queue = queue.Queue()
    reader = threading.Thread(
        target=_read_monitor_lines,
        args=(process.stdout, output_queue),
        daemon=True,
    )
    reader.start()

    header = None
    body = []
    while True:
        timeout = EVENT_SETTLE_SECONDS if header is not None else None
        try:
            line = output_queue.get(timeout=timeout)
        except queue.Empty:
            yield header, body
            header = None
            body = []
            continue

        if line is None:
            if header is not None:
                yield header, body
            return

        line = line.rstrip("\r\n")
        if line.startswith(MESSAGE_PREFIXES):
            if header is not None:
                yield header, body
            header = line
            body = []
        elif header is not None and not line.strip():
            yield header, body
            header = None
            body = []
        elif header is not None:
            body.append(line)


def command_output(argv):
    environment = os.environ.copy()
    environment["LC_ALL"] = "C"
    return subprocess.run(
        argv,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=environment,
    )


def steam_tty1_sessions():
    result = command_output(
        [LOGINCTL, "list-sessions", "--no-legend", "--no-pager", "--no-ask-password"]
    )
    if result.returncode != 0:
        log("could not list login sessions: " + result.stderr.strip())
        return None

    session_ids = []
    for line in result.stdout.splitlines():
        fields = line.split()
        if not fields:
            continue
        session_id = fields[0]
        if not re.fullmatch(r"[A-Za-z0-9_.:-]+", session_id):
            log("ignoring an unexpected login session identifier")
            continue
        if session_id not in session_ids:
            session_ids.append(session_id)

    matches = []
    for session_id in session_ids:
        result = command_output(
            [
                LOGINCTL,
                "show-session",
                session_id,
                "--no-pager",
                "--no-ask-password",
                "--property=Name",
                "--property=TTY",
            ]
        )
        if result.returncode != 0:
            continue
        properties = {}
        for line in result.stdout.splitlines():
            name, separator, value = line.partition("=")
            if separator:
                properties[name] = value
        if properties.get("Name") == "steam" and properties.get("TTY") == "tty1":
            matches.append(session_id)
    return matches


def switch_to_desktop(requested_desktop):
    log("accepted desktop switch request for " + requested_desktop)
    result = subprocess.run([SESSION_SELECT, "desktop"], check=False)
    if result.returncode != 0:
        log("steamos-session-select failed with status " + str(result.returncode))
        return False

    matches = steam_tty1_sessions()
    if matches is None:
        return False
    if len(matches) != 1:
        log("refusing handoff: expected one steam tty1 session, found " + str(len(matches)))
        return False

    session_id = matches[0]
    result = subprocess.run(
        [LOGINCTL, "terminate-session", session_id, "--no-ask-password"], check=False
    )
    if result.returncode != 0:
        log("could not terminate steam tty1 session " + session_id)
        return False
    log("terminated steam tty1 session " + session_id)
    return True


def self_test():
    valid_header = (
        "method call time=1.0 sender=:1.42 -> "
        "destination=org.freedesktop.DisplayManager serial=7 "
        "path=/org/freedesktop/DisplayManager/Seat0; "
        "interface=org.freedesktop.DisplayManager.Seat; member=SwitchToUser"
    )
    valid = valid_header + '\n   string "doorstop"\n   string "desktop"\n'
    events = list(text_events(valid.splitlines(True)))
    assert len(events) == 1
    assert parse_request(*events[0]) == "desktop"

    for desktop in ("plasma", "plasma-wayland"):
        assert parse_request(
            valid_header, ['   string "doorstop"', '   string "' + desktop + '"']
        ) == desktop

    rejected = (
        (valid_header.replace(DESTINATION, "org.example.Wrong"),
         ['   string "doorstop"', '   string "desktop"']),
        (valid_header.replace(OBJECT_PATH, "/org/example/Wrong"),
         ['   string "doorstop"', '   string "desktop"']),
        (valid_header,
         ['   string "root"', '   string "desktop"']),
        (valid_header,
         ['   string "doorstop"', '   string "gamescope"']),
        (valid_header,
         ['   string "doorstop"', '   string "desktop"', '   string "extra"']),
        (valid_header,
         ['   string "doorstop"', '   variant       string "desktop"']),
    )
    for event in rejected:
        assert parse_request(*event) is None

    print("ps5-session-switch-listener: self-test passed")
    return 0


def main():
    if len(sys.argv) == 2 and sys.argv[1] == "--self-test":
        return self_test()
    if len(sys.argv) != 1:
        print("usage: ps5-session-switch-listener [--self-test]", file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        log("must run as root")
        return 1

    process = subprocess.Popen(
        [DBUS_MONITOR, "--system", "--monitor", MATCH_RULE],
        stdout=subprocess.PIPE,
        text=True,
        bufsize=1,
    )
    last_request = float("-inf")
    try:
        for header, body in live_events(process):
            requested_desktop = parse_request(header, body)
            if requested_desktop is None:
                continue
            now = time.monotonic()
            if now - last_request < DEBOUNCE_SECONDS:
                log("ignored duplicate desktop switch request")
                continue
            last_request = now
            switch_to_desktop(requested_desktop)
    finally:
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()

    log("dbus-monitor exited unexpectedly with status " + str(process.returncode))
    return 1


if __name__ == "__main__":
    sys.exit(main())
