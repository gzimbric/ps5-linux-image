#!/bin/bash
# Update bzImage and initrd.img on the PS5 boot partition (/boot/efi) for the
# installed linux-ps5 kernel.
#
# The pacman hook /etc/pacman.d/hooks/95-ps5-boot-files.hook runs this after
# a transaction that changes the kernel or what goes into the initramfs. Run
# it by hand after editing /etc/mkinitcpio.conf or /etc/modprobe.d.
#
# It builds a new initramfs with mkinitcpio and checks it before anything is
# replaced: it has to hold amdgpu for this kernel, the eight Cyan Skillfish 2
# firmware files and ps5-amdgpu.conf, none of the Wi-Fi driver, its firmware
# or the frequency drivers, and it has to pass the bounded firmware 11.60
# loader's checks (ps5-1160-check-boot-files) together with the kernel. Only
# then does it replace the files. The pair that was on /boot/efi is kept as
# bzImage.prev and initrd.img.prev. If anything fails, /boot/efi and
# /boot/initrd.img-<version> are left as they were.
#
# --no-mkinitcpio  use the existing /boot/initrd.img-<version> as it is
# --no-backup      do not keep the .prev copies (the image build uses this:
#                  the base image's 7.1.7 files are no use with this kernel)
# --precheck       only check that /boot/efi can be updated, and change
#                  nothing. 05-ps5-boot-files-precheck.hook runs this before a
#                  transaction that installs linux-ps5, so pacman refuses the
#                  kernel change instead of leaving the old kernel on /boot/efi
#                  with the new kernel's modules on the root filesystem.
set -euo pipefail
export LC_ALL=C

efi=/boot/efi
check=/usr/local/sbin/ps5-1160-check-boot-files
rebuild=1 backup=1 precheck=0 renaming=0
cleanup_files=()

cleanup() {
  ((${#cleanup_files[@]} == 0)) || rm -f -- "${cleanup_files[@]}"
}
trap cleanup EXIT

die() {
  echo "ps5-update-boot-files: $*" >&2
  if ((precheck)); then
    echo "ps5-update-boot-files: mount the boot partition read-write at $efi, then run pacman again" >&2
  elif ((renaming)); then
    echo "ps5-update-boot-files: $efi may be partly updated; bzImage.prev and initrd.img.prev are the files that were there" >&2
  else
    echo "ps5-update-boot-files: $efi was not changed" >&2
  fi
  exit 1
}

for arg; do
  case $arg in
    --no-mkinitcpio) rebuild=0 ;;
    --no-backup) backup=0 ;;
    --precheck) precheck=1 ;;
    *) echo "Usage: $0 [--no-mkinitcpio] [--no-backup] | --precheck" >&2; exit 2 ;;
  esac
done
((EUID == 0)) || die "run as root"

mountpoint -q "$efi" || die "$efi is not mounted"
[[ -w $efi ]] || die "$efi is not writable"
[[ -f $efi/cmdline.txt ]] || die "$efi/cmdline.txt is missing"
if ((precheck)); then
  echo "$efi is mounted and writable"
  exit 0
fi

# The kernel version comes from the installed linux-ps5 package. Reading the
# local database directly keeps pacman out of its own hook.
shopt -s nullglob
dbs=(/var/lib/pacman/local/linux-ps5-[0-9]*/files)
shopt -u nullglob
((${#dbs[@]} == 1)) || die "expected one installed linux-ps5, found ${#dbs[@]}"
kver=$(sed -n 's|^boot/vmlinuz-||p' "${dbs[0]}")
[[ -n $kver && $kver != *$'\n'* ]] || die "cannot find the kernel in ${dbs[0]%/files}"
kernel=/boot/vmlinuz-$kver
initrd=/boot/initrd.img-$kver
[[ -f $kernel ]] || die "$kernel is missing"
[[ -d /usr/lib/modules/$kver ]] || die "/usr/lib/modules/$kver is missing"

# Left over from an update that was cut off.
staged=("$efi/bzImage.new" "$efi/initrd.img.new" "$efi/bzImage.prev.new" "$efi/initrd.img.prev.new")
rm -f -- "${staged[@]}"
cleanup_files+=("${staged[@]}")

# The same checks the image build makes on its initramfs.
check_initramfs() { # initramfs
  local contents name missing=()
  contents=$(lsinitcpio "$1") || die "lsinitcpio cannot read $1"
  grep -Eq "^usr/lib/modules/${kver//./\\.}/kernel/drivers/gpu/drm/amd/amdgpu/amdgpu\\.ko(\\.zst)?\$" \
    <<<"$contents" || missing+=("amdgpu.ko for $kver")
  for name in ce me mec mec2 pfp rlc sdma sdma1; do
    grep -qxF "usr/lib/firmware/amdgpu/cyan_skillfish2_$name.bin" <<<"$contents" ||
      missing+=("cyan_skillfish2_$name.bin")
  done
  grep -qxF etc/modprobe.d/ps5-amdgpu.conf <<<"$contents" || missing+=(ps5-amdgpu.conf)
  ((${#missing[@]} == 0)) || die "$1 is missing ${missing[*]}"
  if grep -Eq '(^|/)((mlan|moal|mt7921e|ps5-cpufreq|ps5-gpufreq)\.ko(\.zst)?|pcieuartiw620[^/]*)$' \
    <<<"$contents"; then
    die "$1 has the Wi-Fi driver, its firmware or a frequency driver"
  fi
  echo "$1: amdgpu for $kver, the GPU firmware and ps5-amdgpu.conf, no Wi-Fi or frequency drivers"
}

new_initrd=$initrd
if ((rebuild)); then
  new_initrd=$initrd.new
  rm -f -- "$new_initrd"
  cleanup_files+=("$new_initrd")
  mkinitcpio -k "$kver" -g "$new_initrd" || die "mkinitcpio failed"
fi
[[ -f $new_initrd ]] || die "$new_initrd is missing"
check_initramfs "$new_initrd"
"$check" "$kernel" "$new_initrd" "$efi/cmdline.txt" ||
  die "the bounded 11.60 loader would refuse these files"

# Copy everything before renaming anything, so a failed copy changes nothing.
changed=()
for pair in "$new_initrd:initrd.img" "$kernel:bzImage"; do
  src=${pair%%:*} name=${pair##*:}
  if cmp -s -- "$src" "$efi/$name"; then
    echo "$efi/$name is up to date"
    continue
  fi
  cp -- "$src" "$efi/$name.new" || die "could not write $efi/$name.new"
  changed+=("$name")
done
# Keep the pair that was there, both files, so the .prev files always belong
# together.
if ((${#changed[@]} > 0 && backup)); then
  for name in bzImage initrd.img; do
    [[ -f $efi/$name ]] || continue
    rm -f -- "$efi/$name.prev"
    cp -- "$efi/$name" "$efi/$name.prev.new" || die "could not write $efi/$name.prev.new"
  done
fi
sync -f "$efi"

renaming=1
for name in bzImage initrd.img; do
  [[ ! -f $efi/$name.prev.new ]] || mv -f -- "$efi/$name.prev.new" "$efi/$name.prev" ||
    die "could not rename $efi/$name.prev.new"
done
for name in "${changed[@]}"; do
  mv -f -- "$efi/$name.new" "$efi/$name" || die "could not rename $efi/$name.new"
  echo "Updated $efi/$name: $(stat -c %s "$efi/$name") bytes, sha256 $(sha256sum "$efi/$name" | cut -d' ' -f1)"
done
sync -f "$efi"
if ((rebuild)); then
  mv -f -- "$new_initrd" "$initrd" || die "could not rename $new_initrd"
fi
if ((${#changed[@]} > 0 && backup)); then
  echo "The previous files are $efi/bzImage.prev and $efi/initrd.img.prev."
fi
echo "Boot files for $kver are on $efi. They need the bounded 11.60 loader."
