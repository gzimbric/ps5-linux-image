[Unit]
Description=Request the maximum PS5 fan servo pattern for bring-up testing
After=systemd-udev-trigger.service
Before=ps5-performance.service getty@tty1.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/timeout 30 /bin/sh -c 'while [ ! -c /dev/icc ]; do sleep 1; done'
ExecStart=/usr/local/sbin/ps5_fan_max
RemainAfterExit=yes
TimeoutStartSec=35
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
