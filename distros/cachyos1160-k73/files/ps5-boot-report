#!/bin/sh
set -eu

umask 077
summary=
bounded=
temporary=
# Called by the EXIT trap.
# shellcheck disable=SC2329
cleanup() {
    [ -z "$temporary" ] || rm -f -- "$temporary" || true
    [ -z "$summary" ] || rm -f -- "$summary" || true
    [ -z "$bounded" ] || rm -f -- "$bounded" || true
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

summary=$(mktemp /run/ps5-boot-summary.XXXXXX)
bounded=$(mktemp /run/ps5-boot-report.XXXXXX)

# The report is copied to the FAT partition so testers can share it. It must
# not carry their Wi-Fi network name or access point address (a BSSID can be
# looked up to find where it is). The names this console knows, from its
# saved NetworkManager Wi-Fi profiles and the last scan, are replaced with
# <wifi-name>, wpa_supplicant's lines are dropped, and MAC addresses are
# masked, including the partly masked ones the Wi-Fi driver prints. IP
# addresses stay in.
PS5_REPORT_WIFI_NAMES=$(
    for profile in /etc/NetworkManager/system-connections/* \
        /run/NetworkManager/system-connections/*; do
        [ -f "$profile" ] || continue
        grep -q '^\[wifi\]' "$profile" 2>/dev/null || continue
        sed -n 's/^id=//p; s/^ssid=//p' "$profile" 2>/dev/null
    done
    timeout 5 nmcli --escape no --get-values SSID device wifi list --rescan no 2>/dev/null
) || true
export PS5_REPORT_WIFI_NAMES

scrub() {
    awk '
        BEGIN { count = split(ENVIRON["PS5_REPORT_WIFI_NAMES"], names, "\n") }
        /wpa_supplicant/ { next }
        {
            line = $0
            for (i = 1; i <= count; i++) {
                # nmcli shows a hidden network as an empty name or --.
                if (names[i] == "" || names[i] == "--")
                    continue
                out = ""
                while ((p = index(line, names[i])) > 0) {
                    out = out substr(line, 1, p - 1) "\001"
                    line = substr(line, p + length(names[i]))
                }
                line = out line
            }
            gsub(/\001/, "<wifi-name>", line)
            print line
        }' |
        sed -E 's/\b[0-9A-Fa-fXx]{2}(:[0-9A-Fa-fXx]{2}){5}\b/xx:xx:xx:xx:xx:xx/g'
}

{
    echo "PS5 CachyOS 7.3 boot report"
    printf 'generated='; date -u +%Y-%m-%dT%H:%M:%SZ
    printf 'boot_id='; cat /proc/sys/kernel/random/boot_id
    printf 'uname='; uname -a
    printf 'cmdline='; cat /proc/cmdline
    printf 'uptime='; cat /proc/uptime

    echo
    echo "[mounts]"
    findmnt -rno SOURCE,TARGET,FSTYPE,OPTIONS / 2>&1 || true
    findmnt -rno SOURCE,TARGET,FSTYPE,OPTIONS /boot/efi 2>&1 || true
    lsblk -o NAME,TYPE,SIZE,FSTYPE,LABEL,MOUNTPOINTS 2>&1 || true

    echo
    echo "[boot-files]"
    kver=$(uname -r)
    for boot_file in /boot/efi/bzImage /boot/efi/initrd.img /boot/efi/cmdline.txt \
        /boot/efi/vram.txt "/boot/vmlinuz-$kver" "/boot/initrd.img-$kver"; do
        if [ -f "$boot_file" ]; then
            printf '%s size=%s sha256=%s\n' "$boot_file" \
                "$(stat -c %s "$boot_file" 2>/dev/null || echo unknown)" \
                "$(sha256sum "$boot_file" 2>/dev/null | cut -d ' ' -f 1)"
        else
            printf '%s missing\n' "$boot_file"
        fi
    done

    echo
    echo "[network]"
    ip -brief link 2>&1 || true
    ip -brief address 2>&1 || true
    ip route 2>&1 || true
    nmcli --terse --fields DEVICE,TYPE,STATE device status 2>&1 || true

    echo
    echo "[wifi]"
    for firmware in /boot/efi/lib/nxp/pcieuartiw620_combo_v1.bin \
        /lib/firmware/nxp/pcieuartiw620_combo_v1.bin; do
        if [ -f "$firmware" ]; then
            printf '%s %s bytes %s\n' "$firmware" "$(stat -c %s "$firmware")" \
                "$(sha256sum "$firmware" | cut -d' ' -f1)"
        else
            printf '%s missing\n' "$firmware"
        fi
    done
    for module in cfg80211 mlan moal; do
        if [ -d "/sys/module/$module" ]; then
            printf 'module %s loaded\n' "$module"
        else
            printf 'module %s not loaded\n' "$module"
        fi
    done
    printf 'modinfo -n moal: '; modinfo -n moal 2>&1 || true
    printf 'tainted='; cat /proc/sys/kernel/tainted 2>&1 || true
    for dev in /sys/bus/pci/devices/*; do
        [ "$(cat "$dev/vendor" 2>/dev/null)" = 0x1b4b ] || continue
        [ "$(cat "$dev/device" 2>/dev/null)" = 0x2b56 ] || continue
        driver=none
        [ ! -e "$dev/driver" ] || driver=$(basename "$(readlink "$dev/driver")")
        net=
        for iface in "$dev"/net/*; do
            [ ! -e "$iface" ] || net="$net ${iface##*/}"
        done
        printf '%s driver=%s net=%s\n' "${dev##*/}" "$driver" "${net# }"
    done
    # Count only; network names stay out of the report. --rescan no uses the
    # last scan instead of waiting for a new one.
    printf 'wifi networks in scan: '
    timeout 5 nmcli --terse --fields SSID device wifi list --rescan no 2>/dev/null | wc -l
    dmesg --color=never 2>&1 | grep -E 'wlan:|WLAN|PCIEIW620|FW download|Request firmware|request_firmware' \
        | tail -n 40 || true

    echo
    echo "[bluetooth]"
    lsusb -d 1286:2059 2>&1 || true
    lsusb -t 2>&1 || true
    btusb=$(modinfo -n btusb 2>/dev/null || true)
    printf 'btusb=%s\n' "${btusb:-unavailable}"
    if [ -n "$btusb" ] && [ -f "$btusb" ]; then
        sha256sum "$btusb" 2>&1 || true
    fi
    printf 'btusb vermagic='; modinfo -F vermagic btusb 2>&1 || true
    printf 'btusb srcversion='; modinfo -F srcversion btusb 2>&1 || true
    lsmod 2>&1 | grep -E '^(btusb|btintel|btbcm|btrtl|btmtk|bluetooth|hid_playstation)' || true
    bluetoothctl list 2>&1 || true
    bluetoothctl show 2>&1 || true
    if command -v btmgmt >/dev/null 2>&1; then
        btmgmt info 2>&1 || true
    fi
    rfkill list bluetooth 2>&1 || true
    for controller in /sys/class/bluetooth/hci*; do
        [ -e "$controller" ] || continue
        printf '%s address=%s path=%s\n' "${controller##*/}" \
            "$(cat "$controller/address" 2>/dev/null || echo unavailable)" \
            "$(readlink -f "$controller/device" 2>/dev/null || echo unavailable)"
    done
    for device in /sys/bus/usb/devices/*; do
        [ "$(cat "$device/idVendor" 2>/dev/null)" = 1286 ] || continue
        [ "$(cat "$device/idProduct" 2>/dev/null)" = 2059 ] || continue
        printf '%s power/control=%s\n' "${device##*/}" \
            "$(cat "$device/power/control" 2>/dev/null || echo unavailable)"
    done
    dmesg --color=never 2>&1 | \
        grep -Ei 'Bluetooth|btusb|hci[0-9]|1286|2059|opcode|xhci|usb.*disconnect|error -[0-9]+' | \
        tail -n 160 || true

    echo
    echo "[pci]"
    lspci -nnk 2>&1 || true

    echo
    echo "[display]"
    for status_file in /sys/class/drm/card*-*/status; do
        [ -e "$status_file" ] || continue
        connector=${status_file%/status}
        printf '%s=' "$status_file"
        cat "$status_file" 2>/dev/null || true
        if [ -e "$connector/modes" ]; then
            printf '%s:\n' "$connector/modes"
            cat "$connector/modes" 2>/dev/null || true
        fi
    done
    for state_file in /sys/class/graphics/fb*/name /sys/class/graphics/fb*/modes; do
        [ -e "$state_file" ] || continue
        printf '%s:\n' "$state_file"
        cat "$state_file" 2>/dev/null || true
    done

    echo
    echo "[temperatures]"
    sensors 2>&1 || true

    # Build 3 loads the frequency drivers after the fixed fan request unless
    # the FAT opt-out is present. Record both the decision and the resulting
    # clocks and temperatures.
    echo
    echo "[thermals-and-clocks]"
    if [ -e /boot/efi/disable-ps5-performance ]; then
        echo "performance opt-out: present"
    else
        echo "performance opt-out: absent"
    fi
    for module in k10temp ps5_cpufreq ps5_gpufreq; do
        if [ -d "/sys/module/$module" ]; then
            printf 'module %s loaded\n' "$module"
        else
            printf 'module %s not loaded\n' "$module"
        fi
    done
    for hwmon in /sys/class/hwmon/hwmon*; do
        [ -e "$hwmon/name" ] || continue
        printf '%s name=%s\n' "$hwmon" "$(cat "$hwmon/name" 2>/dev/null)"
        for value in "$hwmon"/temp*_input "$hwmon"/temp*_label \
            "$hwmon"/freq*_input "$hwmon"/freq*_label \
            "$hwmon"/power*_input "$hwmon"/power*_average \
            "$hwmon"/in*_input "$hwmon"/fan*_input; do
            [ -r "$value" ] || continue
            printf '  %s=%s\n' "${value##*/}" "$(timeout 2 cat "$value" 2>/dev/null)"
        done
    done
    for value in /sys/devices/system/cpu/cpufreq/boost \
        /sys/devices/system/cpu/cpufreq/policy*/scaling_driver \
        /sys/devices/system/cpu/cpufreq/policy*/scaling_governor \
        /sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq \
        /sys/devices/system/cpu/cpufreq/policy*/scaling_min_freq \
        /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq \
        /sys/devices/system/cpu/cpufreq/policy*/scaling_available_frequencies \
        /sys/devices/system/cpu/cpufreq/policy*/stats/total_trans; do
        [ -r "$value" ] || continue
        printf '%s=%s\n' "$value" "$(timeout 2 cat "$value" 2>/dev/null | tr '\n' ' ')"
    done
    [ -d /sys/devices/system/cpu/cpufreq/policy0 ] || echo "cpufreq: no policy"
    grep -E '^cpu MHz' /proc/cpuinfo 2>/dev/null | sort | uniq -c || true
    for dev in /sys/class/devfreq/*; do
        [ -e "$dev" ] || continue
        for attr in name governor cur_freq target_freq min_freq max_freq \
            available_frequencies polling_interval; do
            [ -r "$dev/$attr" ] || continue
            printf '%s/%s=%s\n' "$dev" "$attr" \
                "$(timeout 2 cat "$dev/$attr" 2>/dev/null | tr '\n' ' ')"
        done
    done
    for card in /sys/class/drm/card*; do
        case ${card##*/} in *-*) continue ;; esac
        for attr in gpu_busy_percent pp_dpm_sclk pp_dpm_mclk pp_dpm_fclk \
            pp_dpm_socclk power_dpm_force_performance_level; do
            [ -r "$card/device/$attr" ] || continue
            printf '%s/device/%s=%s\n' "$card" "$attr" \
                "$(timeout 2 cat "$card/device/$attr" 2>/dev/null | tr '\n' ' ')"
        done
    done

    echo
    echo "[session-and-sleep]"
    printf 'next tty1 session='; cat /home/steam/.config/ps5-next-session 2>&1 || true
    printf 'foreground vt='; fgconsole 2>&1 || true
    loginctl list-sessions --no-legend 2>&1 || true
    for target in sleep suspend hibernate hybrid-sleep suspend-then-hibernate; do
        printf '%s.target=' "$target"
        systemctl is-enabled "$target.target" 2>&1 || true
    done

    echo
    echo "[kernel-7.3]"
    dmesg --color=never 2>&1 | grep -E 'Strawberry was here|MP1ERROR|cpu frequency|gpufreq|cpufreq|vcn|VCN|Salina|amdgpu.*(ring|ip block)' \
        | tail -n 80 || true

    echo
    echo "[services]"
    # --lines=0: the unit log lines are in the journal tail, scrubbed.
    systemctl --no-pager --full --lines=0 status \
        NetworkManager.service bluetooth.service sshd.service getty@tty1.service \
        first-boot.service ps5fan.service ps5-amdgpu-reprobe.service \
        ps5-iw620-firmware.service ps5-bt-quiet.service ps5-performance.service \
        ps5-session-switch-listener.service \
        ps5-boot-report.timer 2>&1 || true
    systemctl --no-pager --full --failed 2>&1 || true
    systemctl --no-pager --full list-jobs 2>&1 || true
} > "$summary" 2>&1

# Preserve the bring-up summary even if a noisy journal has very large records.
# Everything is scrubbed before it is cut to size, so the limits still hold.
scrub < "$summary" | head -c 393216 > "$bounded"

{
    printf '\n[kernel-tail; final 256 KiB]\n'
    dmesg --color=never 2>&1 | tail -n 500 | scrub | tail -c 262144
    printf '\n[journal-tail; final 383 KiB]\n'
    journalctl -b --no-pager -n 800 2>&1 | scrub | tail -c 392192
} >> "$bounded"

test -s "$bounded"
test "$(wc -c < "$bounded")" -le 1048576

publish_report() {
    destination=$1
    temporary=$(mktemp "${destination}.new.XXXXXX") || return 1
    if ! install -m 0600 "$bounded" "$temporary"; then
        rm -f "$temporary"
        temporary=
        return 1
    fi
    if ! sync -f "$temporary"; then
        rm -f "$temporary"
        temporary=
        return 1
    fi
    if ! mv -f "$temporary" "$destination"; then
        rm -f "$temporary"
        temporary=
        return 1
    fi
    temporary=
    sync -f "$destination" || \
        echo "Could not flush $destination after rename" >&2
}

publish_report /var/log/ps5-boot-report.txt || \
    echo "Could not publish /var/log/ps5-boot-report.txt" >&2

if findmnt -rn /boot/efi >/dev/null 2>&1 && [ -w /boot/efi ]; then
    publish_report /boot/efi/ps5-boot-report.txt || \
        echo "Could not publish /boot/efi/ps5-boot-report.txt" >&2
fi

exit 0
