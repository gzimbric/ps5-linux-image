M etc/pacman.conf f 0644 0 0 3019 9aa21b480b54adea829ee5b69f63ad421807a9d313fa0a52b23ad6135637c139
A etc/pacman.d/hooks d 0755 0 0 - -
A etc/pacman.d/hooks/95-ps5-boot-files.hook f 0644 0 0 854 118706039c4435455cbc59e25431ee8ab5e18a56abd6a41e99cafd2cb9b1a995
A etc/ps5-first-boot-done f 0644 0 0 0 e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
A etc/systemd/system/multi-user.target.wants/ps5-amdgpu-reprobe.service l 0777 0 0 - /etc/systemd/system/ps5-amdgpu-reprobe.service
A etc/systemd/system/multi-user.target.wants/ps5-iw620-firmware.service l 0777 0 0 - /etc/systemd/system/ps5-iw620-firmware.service
