diff --git a/mlinux/moal_main.h b/mlinux/moal_main.h
index 8153bf5..c2269e7 100644
--- a/mlinux/moal_main.h
+++ b/mlinux/moal_main.h
@@ -180,6 +180,20 @@ Change log:
 #include <linux/pm_qos_params.h>
 #endif
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0)
+/* Linux 7.3 removed strncpy(). This keeps its semantics: copy at most
+ * count bytes, stop at the first NUL and zero-fill the rest. */
+static inline char *woal_strncpy(char *dest, const char *src, size_t count)
+{
+	size_t len = strnlen(src, count);
+
+	memcpy(dest, src, len);
+	memset(dest + len, 0, count - len);
+	return dest;
+}
+#define strncpy(dest, src, count) woal_strncpy(dest, src, count)
+#endif
+
 #ifndef MIN
 /** Find minimum */
 #define MIN(a, b) ((a) < (b) ? (a) : (b))
