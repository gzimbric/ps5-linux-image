+
+#define PS5_PRO_GPU_DEVICE_ID_0	0x13da
+#define PS5_PRO_GPU_DEVICE_ID_1	0x13dc
+
+static inline bool amdgpu_is_ps5_pro(struct pci_dev *pdev)
+{
+	return pdev->vendor == PCI_VENDOR_ID_ATI &&
