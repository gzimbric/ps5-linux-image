#!/bin/bash
# steamos-session-select — switch between Gamescope and KDE Plasma (no SDDM).
#
# Called by Steam's "Power > Switch to Desktop" (passes "desktop") and by the
# "Return to Gaming Mode" desktop shortcut (passes "gamescope").
#
# Mechanism
#   Root    : write ~/.config/ps5-next-session to "plasma" or "gamescope"
#   Non-root: sudo to write the token, then end / restart the session.
#
# Direction notes
#   Both directions set the next-session token, then terminate the current tty1
#   session. agetty autologin respawns it and the profile.d launcher reads the
#   token before starting Gamescope or Plasma.
#
# Optional: write `plasmax11` to ~/.config/ps5-next-session for an X11 escape
# hatch via startx + startplasma-x11 (ps5-tty-session.sh).

set -euo pipefail

MARKER="/etc/ps5-use-tty-sessions"
SESSION_FILE="/home/steam/.config/ps5-next-session"

session="${1:-gamescope}"

# ---------- Root path: write next tty session token ----------
if [[ $EUID -eq 0 ]]; then
    case "$session" in
        gamescope)
            next="gamescope"
            ;;
        desktop|plasma|plasma-wayland|plasmax11)
            next="plasma"
            ;;
        *)
            echo >&2 "steamos-session-select: unrecognised session '$session'"
            exit 1
            ;;
    esac

    if [[ ! -f "$MARKER" ]]; then
        echo >&2 "steamos-session-select: $MARKER missing — image not using tty sessions"
        exit 1
    fi

    session_dir="${SESSION_FILE%/*}"
    if [[ ! -d "$session_dir" ]]; then
        install -d -m 0755 -o steam -g steam "$session_dir"
    fi

    # Keep readers from observing a truncated token if power is lost or the
    # session handoff begins while this file is being updated.
    session_tmp="$(mktemp "$session_dir/.ps5-next-session.XXXXXX")"
    trap 'rm -f -- "$session_tmp"' EXIT
    printf '%s\n' "$next" >"$session_tmp"
    chown steam:steam "$session_tmp"
    chmod 0644 "$session_tmp"
    sync -f "$session_tmp"
    mv -f -- "$session_tmp" "$SESSION_FILE"
    sync -f "$SESSION_FILE"
    sync -f "$session_dir"
    trap - EXIT
    echo "steamos-session-select: next tty1 session set to $next"
    exit 0
fi

# ---------- Non-root path: escalate, then end / restart the session ----------
sudo "$(realpath "$0")" "$session"

case "$session" in
    gamescope)
        # Plasma's compositor + shell run under systemd --user (session 2),
        # not the tty1 login session — terminate-session alone leaves them
        # holding DRM and gamescope can't grab the display. Kill them first,
        # then close the tty1 session so profile.d exec's gamescope-session-ps5.
        pkill -u steam plasmashell || true
        pkill -u steam kwin_wayland || true
        pkill -u steam kwin_x11 || true
        pkill -u steam Xwayland || true
        if [[ -n "${XDG_SESSION_ID:-}" ]]; then
            loginctl terminate-session "$XDG_SESSION_ID"
        fi
        ;;
    desktop|plasma|plasma-wayland|plasmax11)
        # Soft handoff: terminate the current session; agetty respawns
        # tty1 and profile.d reads next-session=plasma. Avoids the reboot
        # tax on return-to-desktop.
        if [[ -n "${XDG_SESSION_ID:-}" ]]; then
            loginctl terminate-session "$XDG_SESSION_ID"
        else
            pkill -u steam gamescope-session-ps5 || true
            pkill -u steam gamescope || true
        fi
        ;;
esac
